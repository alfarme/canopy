          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  b.time AS time,\n  l.label AS sensor,\n  b.moisture\nFROM bt_readings b\nJOIN sensors s ON s.id = b.sensor_id\nLEFT JOIN sensor_labels l ON l.sensor_id = b.sensor_id\nWHERE\n  $__timeFilter(b.time)\n  AND s.kind = 'bt' AND s.active = true\nORDER BY b.time",
          "refId": "A",
