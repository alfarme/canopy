      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  b.time AS time,\n  l.label AS sensor,\n  b.battery::float8 AS battery\nFROM bt_readings b\nJOIN sensors s ON s.id = b.sensor_id\nLEFT JOIN sensor_labels l ON l.sensor_id = b.sensor_id\nWHERE\n  $__timeFilter(b.time)\n  AND b.battery IS NOT NULL\n  AND s.active\nORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Battery (%)",
      "type": "timeseries",
      "description": "Sampled every 48 hours by tools/miflora_battery.sh (active GATT read). Roughly half of GATT connects fail, so gaps are normal and the line spans nulls; a flat segment means no new sample, not a stable battery. Old CR2032s sag under the load of a connect and recover at rest, so treat single dips as noise and read the trend."
    },
