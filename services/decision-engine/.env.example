# Database — either DATABASE_URL (wins) or discrete vars
DATABASE_URL=postgresql://canopy:secret@localhost:5432/canopy
# PGHOST=localhost
# PGPORT=5432
# PGUSER=canopy
# PGPASSWORD=secret
# PGDATABASE=canopy

# Decision-engine tuning
INTERVAL_SECONDS=300       # How often to run the evaluation loop (seconds)
STALE_HOURS=24             # Hours without a reading before stale alert fires
STUCK_HOURS=24             # Hours a value must hold identical before stuck alert fires
STUCK_REPEAT_HOURS=24      # Hours between repeat stuck alerts while it stays stuck
BATTERY_LOW_PCT=15         # Battery % below which low_battery alert fires
ALERT_COOLDOWN_HOURS=24    # Min hours between repeats for non-stuck alert kinds (cap: 1x/24h)
LIGHT_OOR_MIN_DAYS=3       # Days of sustained out-of-range light_lux before alert fires

# Logging
LOG_LEVEL=INFO
