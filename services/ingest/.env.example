# Database — DATABASE_URL takes priority over discrete vars
DATABASE_URL=postgresql://canopy:changeme@timescaledb:5432/canopy
# OR use discrete vars (DATABASE_URL overrides if set):
# PGHOST=timescaledb
# PGPORT=5432
# PGUSER=canopy
# PGPASSWORD=changeme
# PGDATABASE=canopy

# MQTT broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=ingest
MQTT_PASSWORD=changeme

# Bucket size in minutes for merging BLE partial readings (default: 30)
BUCKET_MINUTES=30

# Logging
LOG_LEVEL=INFO
