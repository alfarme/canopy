# Telegram bot credentials (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Database connection (DATABASE_URL wins over discrete vars)
DATABASE_URL=postgresql://canopy:password@cp-db:5432/canopy
# OR discrete:
# PGHOST=cp-db
# PGPORT=5432
# PGUSER=canopy
# PGPASSWORD=secret
# PGDATABASE=canopy

# Service tuning
POLL_INTERVAL=30
LOG_LEVEL=INFO

# Phase 4 — Plant identification & OpenPlantbook
PLANTNET_API_KEY=your-plantnet-api-key
# OpenPlantbook uses OAuth2 client_credentials — both are required; the bot
# exchanges them for a bearer token itself (see app/api_clients.py). Get
# both from your account's API keys page at open.plantbook.io.
OPENPLANTBOOK_CLIENT_ID=your-openplantbook-client-id
OPENPLANTBOOK_CLIENT_SECRET=your-openplantbook-client-secret
TELEGRAM_ADMIN_USER_ID=your-numeric-telegram-user-id

# Where /identify photos are saved (species/sensor metadata recorded in the
# identify_photos table) for a future training/dataset feature. Mount a
# persistent volume at this path in production.
PHOTO_STORAGE_DIR=/data/identify-photos
